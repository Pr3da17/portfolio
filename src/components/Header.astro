---
import adamLogo from '../assets/Adam-Ait-Oulahiane.svg';

const links = [
	{ href: '#presentation-container', label: 'Présentation' },
	{ href: '#projets', label: 'Projets' },
	{ href: '#experiences', label: 'Experiences' },
	{ href: '#parcours', label: 'Parcours' },
	{ href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-neutral-200 bg-neutral-50/80 backdrop-blur-md dark:border-neutral-800 dark:bg-neutral-950/80">
	<nav aria-label="Navigation principale" class="flex w-full flex-wrap items-center justify-between gap-2 px-6 py-3.5">
		<a href="/" class="shrink-0 transition-opacity hover:opacity-75">
			<img src={adamLogo.src} alt="Adam Ait Oulahiane" class="h-8 w-auto dark:invert" />
		</a>
		{
			links.map((link) => (
				<a
					href={link.href}
					class="rounded-md px-3 py-1.5 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-200/70 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
				>
					{link.label}
				</a>
			))
		}
		<button
			id="theme-toggle"
			type="button"
			class="inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-md text-neutral-600 transition-colors hover:bg-neutral-200/70 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
		>
			<span class="inline-flex dark:hidden">
				<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
				</svg>
				<span class="sr-only">Passer au thème sombre</span>
			</span>
			<span class="hidden dark:inline-flex">
				<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2" />
					<path d="M12 20v2" />
					<path d="m4.93 4.93 1.41 1.41" />
					<path d="m17.66 17.66 1.41 1.41" />
					<path d="M2 12h2" />
					<path d="M20 12h2" />
					<path d="m6.34 17.66-1.41 1.41" />
					<path d="m19.07 4.93-1.41 1.41" />
				</svg>
				<span class="sr-only">Passer au thème clair</span>
			</span>
		</button>
	</nav>
</header>

<script>
	const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
	const toggle = document.getElementById('theme-toggle');

	function getSystemScheme(): 'light' | 'dark' {
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	}

	function applyStoredScheme(value: string | null) {
		if (!meta) return;
		meta.content = value === 'light' || value === 'dark' ? value : 'light dark';
	}

	toggle?.addEventListener('click', () => {
		if (!meta) return;
		const systemScheme = getSystemScheme();
		const currentRendered =
			meta.content === 'dark' || (meta.content === 'light dark' && systemScheme === 'dark')
				? 'dark'
				: 'light';
		const target = currentRendered === 'dark' ? 'light' : 'dark';

		if (target !== systemScheme) {
			try {
				localStorage.setItem('color-scheme', target);
			} catch {}
			meta.content = target;
		} else {
			try {
				localStorage.removeItem('color-scheme');
			} catch {}
			meta.content = 'light dark';
		}
	});

	window.addEventListener('storage', (event) => {
		if (event.key === 'color-scheme') {
			applyStoredScheme(event.newValue);
		}
	});
</script>
