---
import { Image } from 'astro:assets';
import adamLogo from '../assets/Adam-Ait-Oulahiane.svg';
import photoCv from '../assets/photo cv.png';
---

<div class="min-h-screen">
	<main class="mx-auto flex min-h-screen max-w-4xl flex-col justify-center px-6 py-16">
		<section
			id="hero"
			data-animate="animate__fadeIn"
			class="flex flex-col-reverse items-start justify-between gap-10 rounded-3xl border border-neutral-200/80 bg-white/80 p-8 shadow-xl shadow-neutral-900/5 sm:flex-row sm:items-center sm:p-12 dark:border-neutral-800/80 dark:bg-neutral-900/60 dark:shadow-2xl dark:shadow-black/50"
		>
			<div class="flex flex-col items-start gap-5">
				<a href="/" class="inline-block shrink-0 transition-opacity hover:opacity-75">
					<img src={adamLogo.src} alt="Adam Ait Oulahiane" class="h-10 w-auto dark:invert" />
				</a>
				<h1 class="max-w-md text-2xl leading-tight font-medium tracking-tight text-neutral-900 sm:text-3xl dark:text-neutral-100">
					Je conçois et développe des solutions informatiques complètes, du hardware au software.
				</h1>
			</div>
			<Image
				src={photoCv}
				alt="Photo de Adam Ait Oulahiane"
				loading="eager"
				fetchpriority="high"
				class="h-44 w-44 shrink-0 rounded-2xl border border-neutral-200/80 object-cover shadow-lg shadow-neutral-900/10 ring-1 ring-neutral-900/5 transition-shadow duration-300 hover:shadow-xl hover:shadow-neutral-900/15 sm:h-52 sm:w-52 dark:border-neutral-800 dark:shadow-black/60 dark:ring-white/10 dark:hover:shadow-black/80"
			/>
		</section>
	</main>
</div>
